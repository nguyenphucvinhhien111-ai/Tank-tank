<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 512 512" width="512" height="512">
  <defs>
    <radialGradient id="bgGrad" cx="50%" cy="50%" r="50%">
      <stop offset="0%" stop-color="#1e293b"/>
      <stop offset="100%" stop-color="#0b0d14"/>
    </radialGradient>
    <filter id="glow" x="-20%" y="-20%" width="140%" height="140%">
      <feGaussianBlur stdDeviation="8" result="blur"/>
      <feComposite in="SourceGraphic" in2="blur" operator="over"/>
    </filter>
  </defs>

  <!-- Background Round -->
  <rect width="512" height="512" rx="110" fill="url(#bgGrad)"/>
  <circle cx="256" cy="256" r="215" fill="none" stroke="#00f2fe" stroke-width="12" stroke-dasharray="24 16" filter="url(#glow)"/>

  <!-- Left Tread -->
  <rect x="90" y="110" width="332" height="56" rx="14" fill="#1e2230" stroke="#00f2fe" stroke-width="4"/>
  <!-- Right Tread -->
  <rect x="90" y="346" width="332" height="56" rx="14" fill="#1e2230" stroke="#00f2fe" stroke-width="4"/>

  <!-- Tread treads ribs -->
  <line x1="130" y1="110" x2="130" y2="166" stroke="#475569" stroke-width="6"/>
  <line x1="180" y1="110" x2="180" y2="166" stroke="#475569" stroke-width="6"/>
  <line x1="230" y1="110" x2="230" y2="166" stroke="#475569" stroke-width="6"/>
  <line x1="280" y1="110" x2="280" y2="166" stroke="#475569" stroke-width="6"/>
  <line x1="330" y1="110" x2="330" y2="166" stroke="#475569" stroke-width="6"/>
  <line x1="380" y1="110" x2="380" y2="166" stroke="#475569" stroke-width="6"/>

  <line x1="130" y1="346" x2="130" y2="402" stroke="#475569" stroke-width="6"/>
  <line x1="180" y1="346" x2="180" y2="402" stroke="#475569" stroke-width="6"/>
  <line x1="230" y1="346" x2="230" y2="402" stroke="#475569" stroke-width="6"/>
  <line x1="280" y1="346" x2="280" y2="402" stroke="#475569" stroke-width="6"/>
  <line x1="330" y1="346" x2="330" y2="402" stroke="#475569" stroke-width="6"/>
  <line x1="380" y1="346" x2="380" y2="402" stroke="#475569" stroke-width="6"/>

  <!-- Tank Main Body -->
  <rect x="135" y="145" width="242" height="222" rx="20" fill="#00f2fe" stroke="#0f172a" stroke-width="8"/>

  <!-- Cannon Barrel -->
  <rect x="250" y="234" width="190" height="44" rx="8" fill="#0284c7" stroke="#0f172a" stroke-width="8"/>
  <rect x="420" y="226" width="24" height="60" rx="4" fill="#0f172a"/>

  <!-- Turret Dome -->
  <circle cx="230" cy="256" r="68" fill="#0284c7" stroke="#0f172a" stroke-width="8"/>
  <circle cx="215" cy="240" r="22" fill="#38bdf8" opacity="0.6"/>
</svg>